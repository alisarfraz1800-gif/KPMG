# Copy to .env and fill in. Never commit .env.

# --- Claude ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max  (medium is a good balance for chat)
CLAUDE_EFFORT=medium

# --- What the agent can look at ---
# Folder with the team's ABAP sources (defaults to the repository root)
ABAP_SOURCE_DIR=
# Comma-separated domains Claude may search; leave empty to turn web search off
SAP_WEB_SEARCH_DOMAINS=help.sap.com,community.sap.com,learning.sap.com,developers.sap.com,api.sap.com

# --- Azure Bot / Entra app registration (Microsoft 365 Agents SDK) ---
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
# Local testing with Microsoft 365 Agents Playground only; never in production
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=true

PORT=3978
LOG_LEVEL=INFO
